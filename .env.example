# ══════════════════════════════════════════════════════════════════════
# Curupira Bot - Exemplo de Configuração (.env)
# ══════════════════════════════════════════════════════════════════════
# Copie este arquivo para `.env` e preencha com seus valores reais.
# NUNCA versione o arquivo `.env` - ele contém segredos!

# ── Bot Telegram ───────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=your_telegram_user_id_here

# ── AI Provider ────────────────────────────────────────────────────────
# Opções: "groq" ou "gemini"
AI_PROVIDER=groq

# ── Groq (LLaMA) ───────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TEMPERATURE=0.7

# ── Google Gemini ──────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ── Skills: Sports ─────────────────────────────────────────────────────
# TheSportsDB (cadastre-se em https://www.thesportsdb.com/api.php)
# THESPORTSDB_KEY=your_thesportsdb_key_here

# API-Football (100 requests/dia - https://www.api-football.com/)
# API_FOOTBALL_KEY=your_api_football_key_here

# PandaScore eSports (1000 requests/mês - https://pandascore.co/)
# PANDASCORE_KEY=your_pandascore_key_here

# ── Skills: Google Calendar ────────────────────────────────────────────
# Obtenha credenciais OAuth2 em: https://console.cloud.google.com/
# Veja docs/skills/GOOGLE_CALENDAR_SETUP.md para instruções detalhadas
# GCAL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GCAL_CLIENT_SECRET=your_google_oauth_client_secret
# GCAL_SYNC_INTERVAL_MINUTES=30
# GCAL_CALENDAR_ID=primary

# ── Skills: System Control ─────────────────────────────────────────────
# SYSTEM_CONTROL_SECURITY_LEVEL=normal
# SYSTEM_CONTROL_ALLOW_CUSTOM_COMMANDS=false
# SYSTEM_CONTROL_ALLOW_FILE_WRITES=false

# ── Outras Configurações ───────────────────────────────────────────────
# HEARTBEAT_INTERVAL=1800
# REFLECTION_ENABLED=true
